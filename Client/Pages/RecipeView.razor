@page "/RecipeView"
<link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">

<h1>Recipe View</h1>
<div class="leftpane" >
    <EditForm Model="@Model" >
        <!-- Recipe Name-->
        <!-- Tags -->
        <!-- Recipe Description -->
        <!-- List of Ingredients -->
        <!-- List of Instructions -->
        <InputText @bind-Value="Model.name" style="margin:5px" placeholder="Add Recipe Name"/>
        <br/>
        <InputText @bind-Value="Model.description" style="margin:5px" placeholder="Add Description" />
        <br />
        <InputText @bind-Value="tag" style="margin:5px" placeholder="Add Tag" @onkeyup="TagEnterKeyPressed"/> 
        <button type="button" @onclick="AddTag" style="border-radius: 5px; border: 1px solid black; background-color: white;">+</button>
        <div style="display:flex; flex-direction:row;">
            @{
                foreach(Tag tag in Model.tags){
                    //Make editible
                    <div class="w3-card" style="border-radius: 5px; border: 1px solid black; margin:2px; padding: 2px;">@tag.description</div>
                }
            }
        </div>
        <br />
        <div class="w3-card" style="width: auto; display: flex; flex-direction: column; border-radius: 5px; border: 1px solid black; margin:5px; padding: 2px;">
            New Ingredient: 
            <div>
                <InputText @bind-Value="ingredient.name" placeholder="Ingredient Name" /> 
                <InputText @bind-Value="ingredient.description" style="width:400px" placeholder="(Optional) Description ex: chopped / diced" />
            </div>
            <div>
                <InputNumber @bind-Value="ingredient.amount" placeholder="Amount"/>
                <InputText @bind-Value="ingredient.amountDescription" placeholder="Description of quantity" />
            </div>
            <button type="button" @onclick="AddIngredient" style="border-radius: 5px; border: 1px solid black; background-color: white;">Add Ingredient</button>
        </div>
        <h4 style="margin: 5px">
            Ingredients:
        </h4>
        <div style="display:flex; flex-direction: column;">
            @{
                foreach (Ingredient i in Model.ingredients)
                {
                    <div class="w3-card" style="width: 202.5px; border-radius: 5px; border: 1px solid black; margin-left:5px; margin-top: 5px; padding: 2px;">@i.name @i.description : @i.amount @i.amountDescription</div>
                }
            }
        </div>
        <br />
        <div class="w3-card" style="width: auto; display: flex; flex-direction: column; border-radius: 5px; border: 1px solid black; margin:5px; padding: 2px;">
            Recipe Step @(Model.steps.Count+1):
            <div>
                <InputText @bind-Value="step.description" style="width: 400px; height: 40px;" placeholder="Instruction go here" @onkeyup="StepEnterKeyPressed"/>
            </div>
            <button type="button" @onclick="AddStep" style="border-radius: 5px; border: 1px solid black; background-color: white;">Add Recipe Step</button>
        </div>
        <h4 style="margin: 5px">Recipe Steps:</h4>
        <div style="display:flex; flex-direction: column;">
            @{
                int stepIndex = 1;
                foreach (Step s in Model.steps)
                {
                    <div class="w3-card" style="width: 202.5px; border-radius: 5px; border: 1px solid black; margin-left:5px; margin-top: 5px; padding: 2px;">@stepIndex - @s.description</div>
                    stepIndex++;
                }
            }
        </div>

        <br />
        <br />

        <button type="submit" style="margin:5px; padding: 20px; border-radius: 5px; border: 1px solid black; background-color: white;" @onclick="Submit">Finish</button>
    </EditForm>
</div>

@{
    if (debug == true)
    {
        <div class="rightpane">
            <h3>Model Data:</h3>
            Recipe id: @Model.id
            <br />
            Recipe Name: "@Model.name"
            <br />
            Recipe Description: "@Model.description"
            <br />
            Recipe Tag Count: @Model.tags.Count
            <br />
            Recipe Ingredient Count: @Model.ingredients.Count
            <br />
            Recipe Step Count: @Model.steps.Count
        </div>
    }
}

@code {
    public Recipe Model { get; set; }
    public string tag { get; set; }
    public Ingredient ingredient { get; set; }
    public Step step { get; set; }
    public bool debug = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Model = new Recipe();
        tag = "";
        ingredient = new Ingredient();
        step = new Step();
    }

    private void TagEnterKeyPressed(KeyboardEventArgs e)
    {
        if(e.Code == "Enter")
        {
            AddTag();
        }
    }

    private void StepEnterKeyPressed(KeyboardEventArgs e)
    {
        if (e.Code == "Enter")
        {
            AddStep();
        }
    }


    //TODO: Add validation for each Add... Function
    private void AddTag()
    {
        if (tag != "")
        {
            Model.tags.Add(new Tag(tag));
            tag = "";
        }    
    }

    private void AddIngredient()
    {
        if(ingredient.description != "" && ingredient.amount != 0)
        {
            Model.ingredients.Add(ingredient);
            ingredient = new Ingredient();
        }
    }

    private void AddStep()
    {
        if(step.description != "")
        {
            Model.steps.Add(step);
            step = new Step();
        }            
    }

    private void Submit()
    {
        //TODO: research how to connect to mssql db from webassembly blazor project, and where to place connectionstring
    }
}
