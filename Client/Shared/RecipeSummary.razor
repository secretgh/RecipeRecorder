<!-- Recipe name, Description, Tags -->
@inject NavigationManager NavManager

<style>
    sl-card::part(base) {
        background: var(--sl-color-neutral-0);
    }

    sl-card::part(base):hover {
        background: rgba(11, 155, 227, 0.1);
        border-color: rgba(11, 155, 227, 0.5);
    }

    sl-card::part(base):active {
        background: rgba(65, 139, 176, 0.2);
            border-color: rgba(65, 139, 176, 1);
    }

</style>

 <sl-card onclick="@OnClick">
     <div slot="header">
        @Name
     </div>
    <div>
        @Description
    </div>
     <div slot="footer">
        @{
            foreach(RecipeTag tag in Tags)
            {
                <sl-tag pill>@tag.Tag</sl-tag>
            }
         }
     </div>
 </sl-card>

@code {
    [Parameter]
    public int id { get; set; }
    [Parameter]
    public string Name { get; set; }
    [Parameter]
    public string Description { get; set; } 
    [Parameter]
    public List<RecipeTag> Tags { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Name == null) Name = "Recipe Name";
        if (Description == null) Description = "Description";
        if (Tags == null) { Tags = new List<RecipeTag>(); }
    }

    private void OnClick()
    {
        NavManager.NavigateTo($"/RecipeView/{id}");
    }
}