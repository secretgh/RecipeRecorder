@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject IRecipeService service

<style>
    .drawer-placement-start::part(header-actions){
    display:none;
    }

    .drawer-placement-start::part(overlay) {
    pointer-events: inherit;
    }
</style>
<div class="page">
    <main>
        <sl-drawer 
        noHeader
        placement="start"
        class="drawer-placement-start"
        open="@open"
        >
            <div slot="label">
                Welcome to your recipe needs
                <div style="margin:15px;"/>
                <nav>
                    <div class="nav-item">
                        <NavLink href="" @onclick="()=>{setOpen(false);}">
                            <sl-button style="margin: 2px;">
                                <span class="oi oi-list-rich" aria-hidden="true"></span>
                                Collection of Recipes
                            </sl-button>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink href="ingredient-registry" @onclick="()=>{setOpen(false);}">
                            <sl-button style="margin: 2px;">
                                <span class="oi oi-list-rich" aria-hidden="true"></span>
                                Ingredient Registry
                            </sl-button>
                        </NavLink>
                    </div>
                    <div class="nav-item" >
                        <NavLink href="RecipeEdit" @onclick="()=>{setOpen(false);}">
                            <sl-button style="margin: 2px;">
                                <span class="oi oi-plus" aria-hidden="true"></span>
                                New Recipe
                            </sl-button>
                        </NavLink>
                    </div>
                </nav>
            </div>
            <sl-button slot="footer" variant="primary"
            @onclick="()=>setOpen(false)"
            >
                Close
            </sl-button>
        </sl-drawer>
        <div class="top-row" style="justify-content:space-between">
            <div style="justify-content: start">
                <sl-button id="menuBtn" 
                @onclick="()=>setOpen(true)">
                    Menu
                </sl-button>
            </div>
            <div style="justify-content: end">
                <sl-button @onclick="()=>{SaveToJson();}">Save Data Locally</sl-button>
                <NavLink href="LoadData">
                    <sl-button>Load Data Locally</sl-button>
                </NavLink>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private Lazy<IJSObjectReference> module = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = new(await JS.InvokeAsync<IJSObjectReference>("import", "./js/CustomJavaFunctions.js"));
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module.IsValueCreated)
        {
            await module.Value.DisposeAsync();
        }
    }

    private async Task SaveToJson(){
        await service.SaveRecipesToJson();
        await module.Value.InvokeVoidAsync("notify", "Your recipes have been saved.", "success");
    }

    private bool open = false;
    private void setOpen(bool value)
    {
        if(open == true)
        {
            open = false;
            StateHasChanged();
        }
        else
        {
            open = value;
            StateHasChanged();
        }
    }

}