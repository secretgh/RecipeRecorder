@using RecipeRecorder.Web.Components.RecipeCreationWizard
@using RecipeRecorder.Web.Components.RecipeCreationWizard.SectionEditor
@inject NavigationManager nav
<div class="recipe-creation-wizard">
    <div class="wizard-header mb-4">       
        <nav aria-label="Recipe creation steps">
            <ol class="breadcrumb">
                <li class="breadcrumb-item @(currentStep == 1 ? "active" : "")">
                    @if (currentStep > 1){
                        <button type="button" class="btn btn-link p-0" @onclick="() => GoToStep(1)">
                            Basic Info & Steps                        
                        </button>
                    }                    
                    else{
                        <span>Basic Info & Steps</span>
                    }
                </li>
                @if (currentStep > 1)
                {
                    <li class="breadcrumb-item @(currentStep == 2 ? "active" : "")">
                        <span>Refine Recipe</span>
                    </li>
                }
            </ol>        
        </nav>    
    </div>    
    <div class="wizard-content">
        @if (currentStep == 1){            
            <div class="step-1">
                <div class="mb-4">
                    <label for="recipeName" class="form-label">Recipe Name</label>
                    <input type="text" id="recipeName" class="form-control" @bind="recipeData.Name" placeholder="Enter recipe name" maxlength="200" />  
                </div>
                <RecipeWizardStep1 Steps="@recipeData.WizardSteps" StepsChanged="@OnStepsChanged" />     
            </div>        
            }        
        else if (currentStep == 2){            
            <div class="step-2">                
                <RecipeWizardStep2 RecipeData="@recipeData" RecipeDataChanged="@OnRecipeDataChanged" />    
            </div>        
        }    
    </div>    
    <div class="wizard-navigation mt-4 d-flex justify-content-between">
        <button type="button" class="btn btn-secondary @(currentStep == 1 ? "invisible" : "")" @onclick="PreviousStep">
            <i class="bi bi-arrow-left me-1"></i> Previous        
        </button>        
        @if (currentStep < totalSteps){           
            <button type="button" class="btn btn-primary" @onclick="NextStep" disabled="@(!CanProceedToNextStep())">
                Next <i class="bi bi-arrow-right ms-1"></i>            
            </button>        
        }        
        else{
            <button type="button" class="btn btn-success" @onclick="SaveRecipe" disabled="@(!CanSaveRecipe())">
                <i class="bi bi-check-circle me-1"></i> Save Recipe
            </button>        
        }    
    </div>
</div>

@code {
    [Parameter] public EventCallback<RecipeWizardData> OnRecipeSaved { get; set; }  
    private int currentStep = 1;    
    private const int totalSteps = 2;    
    private RecipeWizardData recipeData = new();    
    private void OnStepsChanged(List<StepWizardData> steps)    {        
        recipeData.WizardSteps = steps;    
    }    
    private void OnRecipeDataChanged(RecipeWizardData updatedData)    {        
        recipeData = updatedData;    
    }    
    private void NextStep()    {        
        if (CanProceedToNextStep()){            
            currentStep++;        
        }    
    }    
    private void PreviousStep()    {        
        if (currentStep > 1)        {            
            currentStep--;        
        }    
    }    
    private void GoToStep(int step)    {        
        if (step == 1 && currentStep == 2)        {            
            // Clear refined data when going back to step 1
            recipeData.Description = string.Empty;            
            recipeData.Recipe.Ingredients.Clear();            
            recipeData.Recipe.Tags.Clear();        
        }        
        currentStep = step;    
    }    
    private bool CanProceedToNextStep()    {        
        return currentStep == 1 && !string.IsNullOrWhiteSpace(recipeData.Name) && recipeData.WizardSteps.Any(s => !string.IsNullOrWhiteSpace(s.Text));    
    }    
    private bool CanSaveRecipe()    {        
        return !string.IsNullOrWhiteSpace(recipeData.Name) && recipeData.WizardSteps.Any(s => !string.IsNullOrWhiteSpace(s.Text));    
    }    
    private async Task SaveRecipe()    {        
        if (CanSaveRecipe())        
        {            
            await OnRecipeSaved.InvokeAsync(recipeData);
            nav.NavigateTo("/recipes");
        }    
    }
}
