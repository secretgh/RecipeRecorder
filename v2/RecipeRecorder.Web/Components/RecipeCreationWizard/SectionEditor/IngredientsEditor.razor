@using RecipeRecorder.Shared.DTOs
@* IngredientsEditor.razor *@
<div class="ingredients-editor">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4><i class="bi bi-basket me-2"></i>Recipe Ingredients</h4>
        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddCustomIngredient">
            <i class="bi bi-plus me-1"></i>Add Custom
        </button>
    </div>

@if (ParsedIngredients.Any())    {
    <div class="alert alert-success mb-3">
        <i class="bi bi-check-circle me-2"></i>Found @ParsedIngredients.Count ingredients from your steps. Add quantities and units below:
        </div>
        @foreach (var parsedName in ParsedIngredients)        {
            var existingIngredient = workingIngredients.FirstOrDefault(i => string.Equals(i.ParsedName, parsedName, StringComparison.OrdinalIgnoreCase));
            if (existingIngredient == null)            {
                existingIngredient = new WorkingIngredient { ParsedName = parsedName };
                workingIngredients.Add(existingIngredient);            
            }
            <div class="ingredient-item mb-3 p-3 border rounded">
                <div class="row align-items-center">
                    <div class="col-md-4">
                        <label class="form-label">Ingredient</label>
                        <div class="input-group">
                            <span class="input-group-text bg-success text-white">#</span>
                            <input type="text" class="form-control" @bind="existingIngredient.DisplayName" placeholder="@parsedName" />
                        </div>
                        @if (!string.IsNullOrEmpty(existingIngredient.IngredientNameModifier))
                        {
                            <small class="text-muted">Modifier: @existingIngredient.IngredientNameModifier</small>
                        }
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Quantity</label>
                        <input type="number" class="form-control" @bind="existingIngredient.Quantity" step="0.1" min="0" placeholder="1" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Unit/Description</label>
                        <input type="text" class="form-control" @bind="existingIngredient.QuantityDesc" placeholder="cup, tablespoon, etc." />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Modifier</label>
                        <input type="text" class="form-control" @bind="existingIngredient.IngredientNameModifier" placeholder="diced, fresh..." />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">&nbsp;</label>
                        <button type="button" class="btn btn-outline-danger btn-sm d-block" @onclick="() => RemoveIngredient(existingIngredient)"> 
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>        
        }    
    }    
    @foreach (var customIngredient in workingIngredients.Where(i => string.IsNullOrEmpty(i.ParsedName)))    {        
        <div class="ingredient-item mb-3 p-3 border rounded bg-light">            
            <div class="row align-items-center">                
                <div class="col-md-4">                    
                    <label class="form-label">Custom Ingredient</label>
                    <input type="text" class="form-control" @bind="customIngredient.DisplayName" placeholder="Enter ingredient name" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Quantity</label>
                    <input type="number" class="form-control" @bind="customIngredient.Quantity" step="0.1" min="0" placeholder="1" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Unit/Description</label>
                    <input type="text" class="form-control" @bind="customIngredient.QuantityDesc" placeholder="cup, tablespoon, etc." />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Modifier</label>
                    <input type="text" class="form-control" @bind="customIngredient.IngredientNameModifier" placeholder="diced, fresh..." />
                </div>
                <div class="col-md-1">
                    <label class="form-label">&nbsp;</label>
                    <button type="button" class="btn btn-outline-danger btn-sm d-block" @onclick="() => RemoveIngredient(customIngredient)">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
        </div>    
    }    
    <div class="mt-3">
        <button type="button" class="btn btn-primary" @onclick="SaveIngredients">
            <i class="bi bi-check me-1"></i>Update Ingredients
        </button>
        <span class="ms-2 text-muted">@workingIngredients.Count(i => !string.IsNullOrWhiteSpace(i.DisplayName)) ingredients ready</span>
    </div>
</div>
@code {
    [Parameter] public List<string> ParsedIngredients { get; set; } = new();
    [Parameter] public List<RecipeIngredientDto> RecipeIngredients { get; set; } = new();
    [Parameter] public EventCallback<List<RecipeIngredientDto>> RecipeIngredientsChanged { get; set; }
    private List<WorkingIngredient> workingIngredients = new();
    protected override void OnInitialized() { InitializeWorkingIngredients(); }
    protected override void OnParametersSet()
    {
        if (workingIngredients.Count == 0)
        {
            InitializeWorkingIngredients();
        }
    }
    private void InitializeWorkingIngredients()
    {
        workingIngredients.Clear();
        // Add parsed ingredients
        foreach (var parsedName in ParsedIngredients)
        {
            var existing = RecipeIngredients.FirstOrDefault(r => string.Equals(r.Ingredient?.IngredientName, parsedName,
            StringComparison.OrdinalIgnoreCase));
            workingIngredients.Add(new WorkingIngredient
            {
                ParsedName = parsedName,
                DisplayName = existing?.Ingredient?.IngredientName
            ?? parsedName,
                Quantity = existing?.Quantity ?? 0,
                QuantityDesc = existing?.QuantityDesc,
                IngredientNameModifier =
            existing?.IngredientNameModifier
            });
        }
        // Add any existing custom ingredients
        foreach (var existing in RecipeIngredients.Where(r => !ParsedIngredients.Any(p => string.Equals(p,
        r.Ingredient?.IngredientName, StringComparison.OrdinalIgnoreCase))))
        {
            workingIngredients.Add(new WorkingIngredient
            {
                ParsedName = "",
                DisplayName = existing.Ingredient?.IngredientName ??
            "",
                Quantity = existing.Quantity,
                QuantityDesc = existing.QuantityDesc,
                IngredientNameModifier =
            existing.IngredientNameModifier
            });
        }
    }
    private void AddCustomIngredient()
    {
        workingIngredients.Add(new WorkingIngredient { ParsedName = "" });
    }
    private void RemoveIngredient(WorkingIngredient ingredient)
    {
        workingIngredients.Remove(ingredient);
    }
    private async Task SaveIngredients()
    {
        var updatedIngredients = new List<RecipeIngredientDto>();
        foreach (var working in workingIngredients.Where(i => !string.IsNullOrWhiteSpace(i.DisplayName)))
        {
            // Create or find ingredient DTO (in real app, you'd call your service to get/create ingredients)
            var ingredientDto = new IngredientDto
            {
                Id = 0,// This would be set by your service
                IngredientName = working.DisplayName
            };
            updatedIngredients.Add(new RecipeIngredientDto
            {
                IngId = ingredientDto.Id,
                RecipeId = 0, // Will be set when recipe is saved
                Quantity = working.Quantity,
                QuantityDesc = working.QuantityDesc,
                IngredientNameModifier = working.IngredientNameModifier,
                Ingredient = ingredientDto
            });
        }
        await RecipeIngredientsChanged.InvokeAsync(updatedIngredients);

    }
    private class WorkingIngredient
    {
        public string ParsedName { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public double Quantity { get; set; } = 0;
        public string? QuantityDesc { get; set; }
        public string? IngredientNameModifier { get; set; }
    }
}
