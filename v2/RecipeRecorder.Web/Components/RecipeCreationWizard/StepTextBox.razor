@* StepTextBox.razor *@
<div class="step-textbox-container mb-4">
    <div class="d-flex align-items-center mb-2">
        <span class="step-number badge bg-primary me-2">@StepNumber</span>
        <label class="form-label mb-0">Step @StepNumber</label>
    </div>
    
    <textarea @bind="stepText" 
              @oninput="OnTextChanged"
              @onblur="ParseDelimiters"
              class="form-control step-textarea"
              rows="3"
              placeholder="Enter your recipe step here. Use #ingredient for ingredients and @@time for time values (e.g., #flour, @@15min)">
    </textarea>
    
    @if (ParsedElements.Any())
    {
        <div class="parsed-elements mt-2">
            <div class="row">
                @if (ParsedIngredients.Any())
                {
                    <div class="col-md-6">
                        <small class="text-muted">Detected Ingredients:</small>
                        <div class="parsed-items">
                            @foreach (var ingredient in ParsedIngredients)
                            {
                                <span class="badge bg-success me-1 mb-1">#@ingredient</span>
                            }
                        </div>
                    </div>
                }
                @if (ParsedTimes.Any())
                {
                    <div class="col-md-6">
                        <small class="text-muted">Detected Times:</small>
                        <div class="parsed-items">
                            @foreach (var time in ParsedTimes)
                            {
                                <span class="badge bg-info me-1 mb-1">@time</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
                                                
@code 
{    
    [Parameter] public int StepNumber { get; set; }    
    [Parameter] public string Text { get; set; } = string.Empty;    
    [Parameter] public EventCallback<string> TextChanged { get; set; }    
    [Parameter] public EventCallback<ParsedStepData> OnStepParsed { get; set; }
    private string stepText = string.Empty;
    private List<ParsedElement> ParsedElements = new();
    public List<string> ParsedIngredients => ParsedElements.Where(e => e.Type == ElementType.Ingredient).Select(e => e.Value).ToList();
    public List<string> ParsedTimes => ParsedElements.Where(e => e.Type == ElementType.Time).Select(e => e.Value).ToList();
    protected override void OnInitialized() { stepText = Text; }
    protected override void OnParametersSet()
    {
        if (stepText != Text)
        {
            stepText = Text; ParseDelimiters();
        }
    }
    private async Task OnTextChanged(ChangeEventArgs e)    {        
        stepText = e.Value?.ToString() ?? string.Empty;        
        await TextChanged.InvokeAsync(stepText);                
        // Real-time parsing (debounced)        
        await Task.Delay(300);        
        if (stepText == e.Value?.ToString())        
        {            
            ParseDelimiters();        
        }    
    }    
    private void ParseDelimiters()
    {
        ParsedElements.Clear();
        if (string.IsNullOrWhiteSpace(stepText))
            return;
        // Parse ingredients (#ingredient)
        var ingredientMatches = System.Text.RegularExpressions.Regex.Matches(stepText, @"#(\w+)",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        foreach (System.Text.RegularExpressions.Match match in ingredientMatches)
        {
            ParsedElements.Add(new ParsedElement
            {
                Type = ElementType.Ingredient,
                Value = match.Groups[1].Value,
                Position =
            match.Index
            });
        }
        // Parse times (@timevalue)
        var timeMatches = System.Text.RegularExpressions.Regex.Matches(stepText,
        @"(@\d+)(?:\s?(mins|min|minute|minutes|hr|hour|hours|sec|second|seconds))", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        foreach (System.Text.RegularExpressions.Match match in timeMatches)
        {
            ParsedElements.Add(new ParsedElement { Type = ElementType.Time, Value = match.Value, Position = match.Index });
        }
        // Notify parent component
        var parsedData = new ParsedStepData
        {
            StepNumber = StepNumber,
            OriginalText = stepText,
            Ingredients = ParsedIngredients,
            Times = ParsedTimes
        };
        OnStepParsed.InvokeAsync(parsedData);
        StateHasChanged();
    }
    public class ParsedElement
    {
        public ElementType Type { get; set; }
        public string Value { get; set; } = string.Empty;
        public int Position { get; set; }
    }
    public enum ElementType
    {
        Ingredient,
        Time
    }
}
