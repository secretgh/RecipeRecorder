    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="LegacyService\**" />
    <Compile Remove="LegacyShared\**" />
    <Compile Remove="Pages\Legacy\**" />
    <Content Remove="LegacyService\**" />
    <Content Remove="LegacyShared\**" />
    <Content Remove="Pages\Legacy\**" />
